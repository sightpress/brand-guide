{
  "$description": "SightPress design tokens. This file is the source of truth: edit it, then run `npm run build`. Every colour pair under `contrast` is checked against WCAG 2.2 and the build fails if one falls short.",
  "palette": {
    "iris": {
      "$description": "Primary brand colour: a deep, confident blue-violet.",
      "50": "#F3F2FF", "100": "#E6E3FF", "200": "#CFCBFF", "300": "#ADA5FF", "400": "#8B80FA",
      "500": "#6A5CF5", "600": "#4A3DE0", "700": "#3D2FC4", "800": "#30259A", "900": "#241C73", "950": "#160F4A"
    },
    "lumen": {
      "$description": "Accent: warm amber, the dot in the mark. Never used for text on light backgrounds.",
      "50": "#FFF8EB", "100": "#FFEDC7", "200": "#FFDB8F", "300": "#FFC95C", "400": "#FFB938",
      "500": "#F2A20C", "600": "#C98200", "700": "#9E6400", "800": "#7A4A00", "900": "#5C3700", "950": "#3A2200"
    },
    "lagoon": {
      "$description": "Secondary: a calm teal for supporting illustration, charts and visited links.",
      "50": "#EEFBF9", "100": "#CCF3EE", "200": "#9BE7DD", "300": "#5FD4C6", "400": "#2DB8A9",
      "500": "#129C8E", "600": "#0E7F75", "700": "#0B6B63", "800": "#0A5550", "900": "#08413D", "950": "#042826"
    },
    "ink": {
      "$description": "Neutrals, from warm paper to deep blue-black ink.",
      "0": "#FFFFFF", "50": "#FBFAF7", "100": "#F2F0E9", "200": "#E2E0D8", "300": "#B9BCD0", "400": "#8A8FA8",
      "500": "#6A7089", "600": "#4A4F6A", "700": "#353A55", "800": "#242842", "900": "#171B36", "950": "#101430", "1000": "#0A0D22"
    },
    "green": { "50": "#E8F6EE", "300": "#6EDB9A", "700": "#105E33", "950": "#0B2A18" },
    "red":   { "50": "#FDECEA", "300": "#FF9C8F", "700": "#9A1B12", "950": "#3A0D09" }
  },
  "color": {
    "light": {
      "bg": "ink.50",
      "surface": "ink.0",
      "surface-sunken": "ink.100",
      "text": "ink.950",
      "text-muted": "ink.600",
      "border": "ink.200",
      "border-strong": "ink.500",
      "accent": "iris.700",
      "accent-hover": "iris.800",
      "accent-subtle": "iris.50",
      "on-accent": "ink.0",
      "link": "iris.700",
      "link-visited": "lagoon.700",
      "highlight": "lumen.400",
      "on-highlight": "ink.950",
      "focus": "ink.950",
      "focus-halo": "lumen.300",
      "success": "green.700",
      "success-subtle": "green.50",
      "warning": "lumen.800",
      "warning-subtle": "lumen.50",
      "danger": "red.700",
      "danger-subtle": "red.50",
      "info": "iris.700",
      "info-subtle": "iris.50"
    },
    "dark": {
      "bg": "ink.950",
      "surface": "ink.900",
      "surface-sunken": "ink.1000",
      "text": "ink.100",
      "text-muted": "ink.300",
      "border": "ink.700",
      "border-strong": "ink.400",
      "accent": "iris.300",
      "accent-hover": "iris.200",
      "accent-subtle": "iris.950",
      "on-accent": "ink.950",
      "link": "iris.300",
      "link-visited": "lagoon.300",
      "highlight": "lumen.400",
      "on-highlight": "ink.950",
      "focus": "lumen.300",
      "focus-halo": "ink.950",
      "success": "green.300",
      "success-subtle": "green.950",
      "warning": "lumen.300",
      "warning-subtle": "lumen.950",
      "danger": "red.300",
      "danger-subtle": "red.950",
      "info": "iris.300",
      "info-subtle": "iris.950"
    }
  },
  "contrast": {
    "$description": "[foreground, background, minimum ratio, what it is for]. 7 = AAA text, 4.5 = AA text, 3 = non-text (borders, icons, focus).",
    "pairs": [
      ["text", "bg", 7, "Body text"],
      ["text", "surface", 7, "Body text on cards"],
      ["text", "surface-sunken", 7, "Body text on sunken panels"],
      ["text-muted", "bg", 7, "Help text and metadata"],
      ["text-muted", "surface", 7, "Help text on cards"],
      ["link", "bg", 7, "Links"],
      ["link", "surface", 7, "Links on cards"],
      ["link-visited", "bg", 4.5, "Visited links"],
      ["accent", "bg", 7, "Brand-coloured text and icons"],
      ["on-accent", "accent", 7, "Text on primary buttons"],
      ["on-accent", "accent-hover", 7, "Text on hovered primary buttons"],
      ["accent", "accent-subtle", 7, "Selected item text"],
      ["on-highlight", "highlight", 7, "Text on amber highlights"],
      ["border-strong", "bg", 3, "Form field borders"],
      ["border-strong", "surface", 3, "Form field borders on cards"],
      ["focus", "bg", 3, "Focus ring"],
      ["focus", "surface", 3, "Focus ring on cards"],
      ["focus", "focus-halo", 3, "Focus ring against its halo"],
      ["focus-halo", "accent", 3, "Focus halo between the ring and a primary button"],
      ["success", "bg", 7, "Success text"],
      ["success", "success-subtle", 7, "Success message"],
      ["warning", "bg", 7, "Warning text"],
      ["warning", "warning-subtle", 7, "Warning message"],
      ["danger", "bg", 7, "Error text"],
      ["danger", "danger-subtle", 7, "Error message"],
      ["info", "info-subtle", 7, "Information message"]
    ],
    "brand": [
      ["ink.50", "iris.700", 7, "The S on the mark's tile"],
      ["lumen.400", "iris.700", 3, "The amber dot on the mark's tile"],
      ["ink.950", "ink.50", 7, "\"Sight\" in the logo, light"],
      ["iris.700", "ink.50", 7, "\"Press\" in the logo, light"],
      ["ink.50", "ink.950", 7, "\"Sight\" in the logo, dark"],
      ["iris.300", "ink.950", 7, "\"Press\" in the logo, dark"],
      ["ink.50", "iris.950", 7, "Social images: \"Sight\" and the headline, violet end of the background"],
      ["iris.300", "iris.950", 7, "Social images: \"Press\", violet end of the background"],
      ["iris.100", "ink.950", 7, "Social images: the line under the headline, ink end of the background"],
      ["iris.100", "iris.950", 7, "Social images: the line under the headline, violet end of the background"],
      ["lumen.400", "ink.950", 7, "Social images: the amber full stop, ink end of the background"],
      ["lumen.400", "iris.950", 7, "Social images: the amber full stop, violet end of the background"]
    ]
  },
  "font": {
    "display": "\"Fraunces\", \"Noto Naskh Arabic\", \"Frank Ruhl Libre\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
    "text": "\"Atkinson Hyperlegible Next\", \"Noto Sans Arabic\", \"Noto Sans Hebrew\", \"Atkinson Hyperlegible\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", sans-serif",
    "mono": "\"Atkinson Hyperlegible Mono\", \"Noto Sans Arabic\", \"Noto Sans Hebrew\", ui-monospace, \"Cascadia Code\", \"SF Mono\", Menlo, Consolas, monospace",
    "script-fallbacks": {
      "$description": "Appended to every stack for scripts the self-hosted fonts do not cover. Arabic and Hebrew are self-hosted (fonts/fonts.css: Noto Sans Arabic and Noto Sans Hebrew for text, Noto Naskh Arabic and Frank Ruhl Libre for display), so their entries here only apply if those files fail to load. Themes self-host the Noto subsets they need for CJK and Devanagari.",
      "ar": "\"Noto Naskh Arabic\", \"Geeza Pro\", \"Segoe UI\", Tahoma, sans-serif",
      "he": "\"Noto Sans Hebrew\", \"Arial Hebrew\", \"Segoe UI\", sans-serif",
      "cjk": "\"Noto Sans CJK SC\", \"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "deva": "\"Noto Sans Devanagari\", \"Kohinoor Devanagari\", \"Nirmala UI\", sans-serif"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "display": 640 },
    "size": {
      "$description": "Major-third scale (1.25) from an 18 px body size, fluid above step 2. rem, so browser zoom and font-size settings always win.",
      "-1": "0.9rem",
      "0": "1.125rem",
      "1": "1.375rem",
      "2": "clamp(1.5rem, 1.35rem + 0.6vw, 1.75rem)",
      "3": "clamp(1.75rem, 1.5rem + 1vw, 2.25rem)",
      "4": "clamp(2rem, 1.6rem + 1.6vw, 2.75rem)",
      "5": "clamp(2.125rem, 1.6rem + 2.6vw, 3.5rem)",
      "6": "clamp(2.25rem, 1.5rem + 3.75vw, 4.5rem)"
    },
    "line-height": { "tight": 1.15, "snug": 1.3, "body": 1.6 },
    "measure": "66ch"
  },
  "space": {
    "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem",
    "6": "2rem", "7": "3rem", "8": "4rem", "9": "6rem"
  },
  "radius": { "sm": "0.375rem", "md": "0.625rem", "lg": "1rem", "xl": "1.5rem", "pill": "999px" },
  "shadow": {
    "1": "0 1px 2px rgb(16 20 48 / 0.08), 0 1px 1px rgb(16 20 48 / 0.04)",
    "2": "0 4px 12px rgb(16 20 48 / 0.10), 0 1px 3px rgb(16 20 48 / 0.06)",
    "3": "0 12px 32px rgb(16 20 48 / 0.14), 0 2px 6px rgb(16 20 48 / 0.06)"
  },
  "focus": { "width": "3px", "offset": "2px" },
  "target": { "min": "44px" },
  "motion": { "fast": "120ms", "base": "200ms", "ease": "cubic-bezier(0.2, 0, 0, 1)" }
}
